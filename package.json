{
  "name": "dynasty",
  "version": "1.0.0",
  "description": "The political map of the Philippines: candidates, winners and dynasties, 2001-2025",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "data": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-data.ts && npm run geo",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "d1:import": "bash scripts/d1-import.sh",
    "d1:import:local": "bash scripts/d1-import.sh --local",
    "deploy": "npm run build && wrangler deploy",
    "geo": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-geo.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.22",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "wrangler": "^4.110.0"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "leaflet": "^1.9.4"
  }
}
