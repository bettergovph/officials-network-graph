{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dynasty",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  // Custom domains. officials.bettergov.ph is still attached to the older "officials" worker; detach it there
  // (or delete that worker) before uncommenting, otherwise the deploy fails.
  "routes": [
    { "pattern": "dynasties.bettergov.ph", "custom_domain": true }
    // , { "pattern": "officials.bettergov.ph", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "dynasty", "database_id": "ef61382e-9282-41df-8345-f22d4e38093a" }
  ]
}
